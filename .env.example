# The token to monitor
API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# openrouter = poll the key's balance/usage from OpenRouter every POLL_MS
# none       = no polling, only count tokens from requests that go through the proxy
PROVIDER=openrouter
POLL_MS=5000

# Proxy target (/proxy/*). Other examples: https://api.openai.com, https://api.groq.com/openai
UPSTREAM_BASE=https://openrouter.ai/api

# Telegram alerts (optional). Create a bot with @BotFather to get the token;
# get your chat id by messaging the bot, then opening
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Name shown at the top of every alert, e.g. "OpenRouter – prod"
TOKEN_NAME=
# Comma-separated dollar thresholds; each one notifies once per crossing.
ALERT_USAGE_ABOVE=          # total used, e.g. 40,45
ALERT_DAILY_ABOVE=          # used today (UTC), e.g. 2,5
ALERT_MONTHLY_ABOVE=        # used this month, e.g. 30
ALERT_REMAINING_BELOW=      # remaining limit, e.g. 10,5,1
# How often to check while no dashboard tab is open (ms)
ALERT_POLL_MS=60000

# Basic auth for the dashboard and proxy. Leave AUTH_PASSWORD empty to disable.
# Proxy clients send the password as their API key (Bearer or x-api-key).
AUTH_USER=admin
AUTH_PASSWORD=

PORT=8787
HOST=127.0.0.1
